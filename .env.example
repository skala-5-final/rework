OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://rework:rework@localhost:5433/rework
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=change-me

# MCP 연결 방식: stdio(로컬 개발 기본) | http(docker compose에서 자동 설정)
MCP_TRANSPORT=stdio
# Worker가 MCP 서버에 보내는 실행 토큰 서명 키 (32바이트 이상)
MCP_TOKEN_SECRET=change-me-mcp-token-secret-32-bytes!
