OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://rework:rework@localhost:5433/rework
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=change-me

# MCP 연결 방식: stdio(로컬 개발 기본) | http(docker compose에서 자동 설정)
MCP_TRANSPORT=stdio
# Worker가 MCP 서버에 보내는 실행 토큰 서명 키 (32바이트 이상)
MCP_TOKEN_SECRET=change-me-mcp-token-secret-32-bytes!

# LangSmith 추적 (선택). 키가 없으면 꺼지고, trace_id·토큰·비용은 DB에만 남는다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=rework

# 컨텍스트 예산 (선택, 기본값은 넉넉함). 넘으면 조사를 줄이고 끝까지 완료한다.
# 예산 초과 시연: RUN_TOKEN_BUDGET=30000
# TOOL_RESULT_MAX_CHARS=12000
# CONTEXT_TOKEN_BUDGET=100000
# RUN_TOKEN_BUDGET=2000000
